{
  "redirects": [
    {
      "source": "/blog",
      "destination": "/balkon",
      "statusCode": 301
    },
    {
      "source": "/blog/:path*",
      "destination": "/balkon/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(.*)\\.md",
      "destination": "/api/markdown?path=$1"
    },
    {
      "source": "/dapur",
      "destination": "/dapur.html"
    },
    {
      "source": "/dapur/:username",
      "destination": "/dapur.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
